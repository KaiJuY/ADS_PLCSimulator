  <DUT Name="ST_PolarIIChamber_ArmServiceCtrl" Id="{14000000-0000-0000-0000-000000000058}">
    <Declaration><![CDATA[TYPE ST_PolarIIChamber_ArmServiceCtrl :
STRUCT
	Lift : ST_PolarIIChamber_LiftTopDownServiceCtrl;
	Rotate : ST_PolarIIChamber_ArmRotateServiceCtrl;
	Nozzle : ARRAY[1..3] OF ST_PolarIIChamber_NozzleSupplyServiceCtrl; // Arm3 supports 1..2; Arm4 supports 1 only.
	NozzlePort : ST_PolarIIChamber_NozzlePortServiceCtrl; // Supported by Arm1 and Arm2 only.
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>

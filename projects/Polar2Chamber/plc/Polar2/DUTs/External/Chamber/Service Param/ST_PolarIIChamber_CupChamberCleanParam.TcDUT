	RecipeCount : UINT; // 0..50; entries are contiguous from index 1
	Recipes : ARRAY[1..50] OF ST_PolarIIChamber_Recipe;
	CleanSettings : ARRAY[1..50] OF ST_PolarIIChamber_CleanSetting; // Active range is 1..ProcessStepCount
END_STRUCT
END_TYPE
]]></Declaration>
